# ============================================================
# TaskFlow — Environment Variables
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in values
# 3. NEVER commit .env to git  (it's in .gitignore)
# ============================================================

# ── MySQL ───────────────────────────────────────────────────
DB_NAME=taskflow_db
DB_USER=taskflow
DB_PASSWORD=taskflow123
DB_ROOT_PASSWORD=rootsecret

# For Aiven (production) — replace with your Aiven host:
# DB_HOST=mysql-xxxxxxx.aivencloud.com
# DB_PORT=12345

# ── JWT ─────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=change-me-in-production-use-at-least-64-chars-long-secret-key!!

# ── Gemini AI ───────────────────────────────────────────────
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Mail (Mailtrap for dev / SendGrid for prod) ─────────────
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Spring Profiles ─────────────────────────────────────────
# Use "demo" to seed 30 sample tasks on first startup
SPRING_PROFILES=default

# ── Frontend API URL ─────────────────────────────────────────
# For Docker Compose (nginx proxies /api internally):
VITE_API_URL=http://localhost:8081
# For Vercel pointing to Render:
# VITE_API_URL=https://taskflow-api.onrender.com

# ── CORS (backend) ───────────────────────────────────────────
# Comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
